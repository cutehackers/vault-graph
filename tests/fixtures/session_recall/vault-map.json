{
  "version": 2,
  "vaults": {
    "main": {"path": "{base}/vaults/main", "role": "personal"},
    "other": {"path": "{base}/vaults/other", "role": "team"},
    "ghost": {"path": "{base}/vaults/ghost", "role": "team"}
  },
  "projects": {
